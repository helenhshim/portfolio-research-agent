{
  "name": "portfolio-research-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "data:probe": "node --env-file=.env.local scripts/sec-data-probe.mjs",
    "data:packets": "node scripts/build-packets.ts",
    "research": "node --env-file=.env.local scripts/research.ts",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --hostname 127.0.0.1",
    "dev:v3": "PORTFOLIO_NEXT_DIST_DIR=.next-v3-dev next dev --hostname 127.0.0.1 --port 3006",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
